DD_ENV=development
DATADOG_API_KEY=your-datadog-api-key-here
DD_APPLICATION_KEY=your-datadog-application-key-here
GOOGLE_GENAI_MODEL=gemini-3-flash-preview
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_APPLICATION_CREDENTIALS=app-creds-file-path.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id # Optional, can also be set in the credentials file
GOOGLE_GENAI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GOOGLE_CLOUD_LOCATION=us-central1
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-8f4e2b1c9d7a3e5f

# Backend API URL for agent tools
API_BASE_URL=http://localhost:8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Datadog RUM (frontend) — create an app at https://app.datadoghq.com/rum/list
VITE_DD_APP_ID=your-rum-application-id
VITE_DD_CLIENT_TOKEN=your-rum-client-token
VITE_DD_SITE=datadoghq.com